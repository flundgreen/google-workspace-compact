{
  "manifest_version": 3,
  "name": "Workspace Compact: more room in Docs, Sheets & Slides",
  "short_name": "Workspace Compact",
  "version": "1.1.0",
  "description": "Moves File/Edit/View onto the title row and removes the Slides Gemini nudge bar, giving your document more vertical space.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "js": ["slides.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["docs.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["sheets.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
